{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-fitness-studio",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      "node_modules/**",
      "data/**",
      "assets_backup/**",
      ".git/**",
      "server/db.js",
      "server/server.js",
      "scripts/**",
      ".env*",
      "package*.json",
      "*.md"
    ]
  }
}
