# .env.example — Muse Fitness Studio Configuration Template
PORT=3000
JWT_SECRET=muse_fitness_studio_super_secret_key_2026
LIVE_SITE_ORIGIN=https://www.musefitnessstudio.com

# ==========================================
# 1. SUPABASE (PostgreSQL Cloud Database)
# ==========================================
# Lấy từ Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==========================================
# 2. CLOUDINARY (Lưu trữ & Tối ưu CDN Hình ảnh)
# ==========================================
# Lấy từ Cloudinary Dashboard (Programmable Media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# 3. TELEGRAM BOT (Thông báo Lead tức thì)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
